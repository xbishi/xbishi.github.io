---
import type { CollectionEntry } from 'astro:content';

type Project = CollectionEntry<'projects'>;

const TYPE_LABEL: Record<string, string> = {
  game: '游戏', app: '应用', tool: '工具', ai: 'AI 管线',
  business: '经营', hardware: '硬件', content: '内容',
};
const STATUS_LABEL: Record<string, string> = {
  active: '进行中', paused: '暂停', done: '已完结', archived: '已归档',
};

interface Props {
  project: Project;
  index?: number; // 展示序号（01. 02. …）
}
const { project, index } = Astro.props;
const d = project.data;
const num = index !== undefined ? String(index + 1).padStart(2, '0') : null;
---

<a href={`/projects/${project.id}/`} class="card group flex flex-col">
  <div class="p-5 flex flex-col gap-2.5 flex-1">
    <div class="flex items-baseline justify-between gap-3">
      <h3 class="font-semibold text-lg text-zinc-100 group-hover:text-accent transition">
        {num && <span class="font-mono text-sm text-accent/80 mr-2">{num}.</span>}{d.title}
      </h3>
      <span class="shrink-0 font-mono text-xs text-zinc-600">{d.year}</span>
    </div>
    <p class="text-sm text-zinc-400 leading-relaxed flex-1">{d.summary}</p>
    <div class="flex flex-wrap items-center gap-2 pt-1">
      <span class={`badge badge-${d.status}`}><i class={`dot dot-${d.status}`} aria-hidden="true"></i>{STATUS_LABEL[d.status]}</span>
      <span class="badge border-white/10 text-zinc-400 bg-white/5">{TYPE_LABEL[d.type]}</span>
      {d.tech.slice(0, 3).map((t) => <span class="font-mono text-xs text-zinc-500 bg-white/5 border border-white/10 px-2 py-0.5 rounded">{t}</span>)}
    </div>
  </div>
</a>
