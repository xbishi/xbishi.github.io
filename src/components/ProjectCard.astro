---
import type { CollectionEntry } from 'astro:content';

type Project = CollectionEntry<'projects'>;

const TYPE_LABEL: Record<string, string> = {
  game: '游戏', app: '应用', tool: '工具', ai: 'AI 管线',
  business: '经营', hardware: '硬件', content: '内容',
};
const STATUS_LABEL: Record<string, string> = {
  active: '进行中', paused: '暂停', done: '已完结', archived: '已归档',
};

interface Props {
  project: Project;
  showCover?: boolean;
}
const { project, showCover = false } = Astro.props;
const d = project.data;
---

<a href={`/projects/${project.id}/`} class="card group flex flex-col">
  {
    showCover && d.cover && (
      <img
        src={d.cover}
        alt={d.title}
        loading="lazy"
        class="w-full aspect-[16/9] object-cover"
      />
    )
  }
  <div class="p-5 flex flex-col gap-2 flex-1">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-semibold text-lg text-zinc-100 group-hover:text-emerald-400 transition">{d.title}</h3>
      <span class="shrink-0 text-xs text-zinc-500">{d.year}</span>
    </div>
    <p class="text-sm text-zinc-400 leading-relaxed flex-1">{d.summary}</p>
    <div class="flex flex-wrap items-center gap-2 pt-1">
      <span class={`badge text-xs px-2 py-0.5 rounded-full border ${`badge-${d.status}`}`}>{STATUS_LABEL[d.status]}</span>
      <span class="text-xs px-2 py-0.5 rounded-full border border-zinc-700 text-zinc-400">{TYPE_LABEL[d.type]}</span>
      {d.tech.slice(0, 3).map((t) => <span class="text-xs text-zinc-500 bg-zinc-800/60 px-2 py-0.5 rounded">{t}</span>)}
    </div>
  </div>
</a>
