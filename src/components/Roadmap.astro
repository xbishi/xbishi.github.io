---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}
const { project } = Astro.props;
const d = project.data;

const pct = d.percent ?? 0;
// 当前阶段 = 第一个未完成的
const currentIndex = d.stages.findIndex((s) => !s.done);
---

{
  (d.stages.length > 0 || d.versions.length > 0) && (
    <section class="mt-12 pt-8 border-t border-white/8">
      {d.stages.length > 0 && (
        <div class="mb-9">
          <p class="kicker mb-4">// roadmap</p>
          <div class="flex items-center gap-2 flex-wrap">
            {d.stages.map((s, i) => (
              <span
                class={`inline-flex items-center gap-1.5 font-mono text-xs px-3 py-1.5 rounded-full border ${
                  s.done
                    ? 'border-accent/40 text-accent bg-accent/10'
                    : i === currentIndex
                      ? 'border-amber-400/50 text-amber-300 bg-amber-400/10'
                      : 'border-white/10 text-zinc-500 bg-white/5'
                }`}
              >
                {/* 阶段旗：done 实旗 / 当前飘旗(呼吸) / 未达空旗 */}
                {s.done ? (
                  <svg class="w-3 h-3" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3 1h2v14H3V1zm3 1h7l-2 3 2 3H6V2z"/></svg>
                ) : i === currentIndex ? (
                  <svg class="w-3 h-3 flag-wave" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M3 1h2v14H3V1zm3 1h7l-2 3 2 3H6V2z"/></svg>
                ) : (
                  <svg class="w-3 h-3 opacity-60" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 1h2v14H3V1zm3 1h7l-2 3 2 3H6V2z"/></svg>
                )}
                {s.name}
              </span>
            ))}
            <span class="font-mono text-sm text-accent ml-1">{pct}%</span>
          </div>

          {/* 进度条：霓虹渐变 + 发光 + 条纹流动 */}
          <div
            class="mt-4 h-2.5 rounded-full bg-white/5 border border-white/10 overflow-hidden"
            role="progressbar"
            aria-valuenow={pct}
            aria-valuemin="0"
            aria-valuemax="100"
          >
            <div
              class="progress-fill h-full rounded-full"
              style={`width:${pct}%`}
            />
          </div>
          <p class="mt-2 font-mono text-[11px] text-zinc-600">
            当前：<span class="text-amber-300">{currentIndex === -1 ? '全部完成' : d.stages[currentIndex]?.name}</span>
          </p>
        </div>
      )}

      {d.versions.length > 0 && (
        <div>
          <p class="kicker mb-4">// versions</p>
          <ol class="timeline">
            {d.versions.map((v) => (
              <li class="relative pl-6 pb-4 last:pb-0">
                <span class="absolute left-0 top-1 w-2.5 h-2.5 rounded-full bg-accent shadow-[0_0_8px_var(--color-accent)]" aria-hidden="true" />
                <span class="font-mono text-sm text-accent">{v.v}</span>
                <span class="text-sm text-zinc-400 ml-3">{v.note}</span>
                {v.date && <span class="font-mono text-xs text-zinc-600 ml-3">{v.date}</span>}
              </li>
            ))}
          </ol>
        </div>
      )}
    </section>
  )
}
