---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const all = (await getCollection('projects')).sort((a, b) => {
  if (a.data.order !== b.data.order) return a.data.order - b.data.order;
  return b.data.year - a.data.year;
});
const featured = all.filter((p) => p.data.featured).slice(0, 4);
const total = all.length;
const activeCount = all.filter((p) => p.data.status === 'active').length;
const doneCount = all.filter((p) => p.data.status === 'done').length;

const TYPE_LABEL: Record<string, string> = {
  all: '全部', game: '游戏', app: '应用', tool: '工具', ai: 'AI 管线',
  business: '经营', hardware: '硬件', content: '内容',
};
const STATUS_LABEL: Record<string, string> = {
  any: '任意状态', active: '进行中', paused: '暂停', done: '已完结', archived: '已归档',
};
---

<Base title="xbishi.dev — 个人项目记录">
  <!-- Hero：终端开场 -->
  <section class="py-12 md:py-16">
    <p class="kicker mb-5">$ whoami<span class="cursor" aria-hidden="true"></span></p>
    <h1 class="text-4xl md:text-6xl font-bold tracking-tight leading-tight text-zinc-100">
      一个人，<span class="headline-grad">做点东西</span>。
    </h1>
    <p class="mt-6 max-w-2xl text-zinc-400 leading-relaxed text-base md:text-lg">
      这里记录我做过的东西：在做的、做完的、停下的。没什么宏大叙事，
      就是一直做，顺便进步。
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-3 font-mono text-sm">
      <span class="border border-white/10 bg-white/5 rounded-lg px-4 py-2"><span class="text-zinc-100 font-bold">{total}</span> <span class="text-zinc-500">项目</span></span>
      <span class="border border-accent/25 bg-accent/10 rounded-lg px-4 py-2"><span class="text-accent font-bold">{activeCount}</span> <span class="text-zinc-500">进行中</span></span>
      <span class="border border-accent-2/25 bg-accent-2/10 rounded-lg px-4 py-2"><span class="text-accent-2 font-bold">{doneCount}</span> <span class="text-zinc-500">已完结</span></span>
      <a href="#projects" class="ml-1 rounded-lg bg-accent text-ink font-semibold px-5 py-2 hover:brightness-110 transition shadow-[0_0_24px_-6px_var(--color-accent)]">浏览全部项目 ↓</a>
    </div>
  </section>

  {featured.length > 0 && (
    <section class="pb-12">
      <p class="kicker mb-3">// featured</p>
      <h2 class="text-xl font-semibold mb-6 text-zinc-200">精选</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
        {featured.map((p, i) => (
          <div class="reveal" style={`transition-delay:${i * 60}ms`}>
            <ProjectCard project={p} index={i} />
          </div>
        ))}
      </div>
    </section>
  )}

  <section id="projects" class="pb-10 scroll-mt-20">
    <p class="kicker mb-3">// ls ./projects</p>
    <h2 class="text-xl font-semibold mb-6 text-zinc-200">全部项目</h2>

    <div class="flex flex-wrap gap-2 mb-3" role="group" aria-label="按类型筛选">
      {Object.entries(TYPE_LABEL).map(([k, v]) => (
        <button class="fbtn font-mono text-xs px-3 py-1.5 rounded-full border border-white/10 text-zinc-400 hover:border-white/25 hover:text-zinc-200 transition" data-type={k} aria-pressed={k === 'all'}>{v}</button>
      ))}
    </div>
    <div class="flex flex-wrap gap-2 mb-8" role="group" aria-label="按状态筛选">
      {Object.entries(STATUS_LABEL).map(([k, v]) => (
        <button class="fbtn font-mono text-xs px-3 py-1 rounded-full border border-white/10 text-zinc-500 hover:border-white/25 hover:text-zinc-300 transition" data-status={k} aria-pressed={k === 'any'}>{v}</button>
      ))}
    </div>

    <div id="grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {all.map((p, i) => (
        <div class="proj reveal" data-type={p.data.type} data-status={p.data.status} style={`transition-delay:${(i % 6) * 50}ms`}>
          <ProjectCard project={p} index={i} />
        </div>
      ))}
    </div>
    <p id="empty" class="hidden text-center text-zinc-600 py-14 font-mono text-sm">// 没有匹配的项目</p>
  </section>
</Base>

<script>
  const state = { type: 'all', status: 'any' };
  const buttons = document.querySelectorAll<HTMLButtonElement>('.fbtn');

  function apply() {
    let visible = 0;
    document.querySelectorAll<HTMLElement>('.proj').forEach((el) => {
      const ok =
        (state.type === 'all' || el.dataset.type === state.type) &&
        (state.status === 'any' || el.dataset.status === state.status);
      el.classList.toggle('hidden', !ok);
      if (ok) {
        visible++;
        el.classList.add('in'); // 筛选出现的卡片立即显示，不等 observer
      }
    });
    document.getElementById('empty')?.classList.toggle('hidden', visible > 0);
    buttons.forEach((b) => {
      const on =
        (b.dataset.type !== undefined && b.dataset.type === state.type) ||
        (b.dataset.status !== undefined && b.dataset.status === state.status);
      b.setAttribute('aria-pressed', String(on));
    });
  }

  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      if (b.dataset.type !== undefined) state.type = b.dataset.type;
      if (b.dataset.status !== undefined) state.status = b.dataset.status ?? 'any';
      apply();
    })
  );
  apply();
</script>
