---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((p) => ({ params: { slug: p.id }, props: { project: p } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;

const TYPE_LABEL: Record<string, string> = {
  game: '游戏', app: '应用', tool: '工具', ai: 'AI 管线',
  business: '经营', hardware: '硬件', content: '内容',
};
const STATUS_LABEL: Record<string, string> = {
  active: '进行中', paused: '暂停', done: '已完结', archived: '已归档',
};
---

<Base title={`${d.title} — xbishi.dev`} description={d.summary}>
  <div class="max-w-3xl mx-auto reveal">
    <a href="/" class="font-mono text-xs text-zinc-500 hover:text-accent transition">← cd ~/projects</a>

    <header class="mt-7 mb-9">
      <div class="flex flex-wrap items-center gap-3 mb-4 font-mono">
        <span class={`badge badge-${d.status}`}><i class={`dot dot-${d.status}`} aria-hidden="true"></i>{STATUS_LABEL[d.status]}</span>
        <span class="badge border-white/10 text-zinc-400 bg-white/5">{TYPE_LABEL[d.type]}</span>
        <span class="text-xs text-zinc-600">{d.year}</span>
      </div>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tight text-zinc-100">{d.title}</h1>
      <p class="mt-4 text-lg text-zinc-400 leading-relaxed">{d.summary}</p>
      {
        (d.links.demo || d.links.repo || d.links.docs) && (
          <div class="mt-7 flex flex-wrap gap-3 font-mono text-sm">
            {d.links.demo && (
              <a href={d.links.demo} target="_blank" rel="noopener" class="px-5 py-2.5 rounded-lg bg-accent text-ink font-semibold hover:brightness-110 transition shadow-[0_0_28px_-8px_var(--color-accent)]">
                在线体验 →
              </a>
            )}
            {d.links.repo && (
              <a href={d.links.repo} target="_blank" rel="noopener" class="px-5 py-2.5 rounded-lg border border-white/15 text-zinc-300 hover:border-accent/50 hover:text-accent transition">
                源码 ↗
              </a>
            )}
            {d.links.docs && (
              <a href={d.links.docs} target="_blank" rel="noopener" class="px-5 py-2.5 rounded-lg border border-white/15 text-zinc-300 hover:border-accent/50 hover:text-accent transition">
                文档 ↗
              </a>
            )}
          </div>
        )
      }
    </header>

    {
      d.cover && (
        <img src={d.cover} alt={d.title} class="w-full rounded-xl border border-white/8 mb-9 shadow-[0_20px_60px_-24px_rgba(0,0,0,0.8)]" />
      )
    }

    <article class="article max-w-none
      [&_h2]:text-zinc-100 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:mt-10 [&_h2]:mb-4
      [&_p]:text-zinc-400 [&_p]:leading-relaxed [&_p]:my-3.5
      [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:text-zinc-400 [&_ul]:marker:text-accent/60 [&_li]:my-1.5
      [&_code]:text-[0.875em] [&_img]:my-4">
      <Content />
    </article>

    <div class="mt-12 pt-7 border-t border-white/8">
      <p class="kicker mb-4">// tech_stack</p>
      <div class="flex flex-wrap gap-2">
        {d.tech.map((t) => <span class="font-mono text-sm text-zinc-300 bg-white/5 border border-white/10 px-3.5 py-1.5 rounded-md">{t}</span>)}
      </div>
    </div>

    <div class="mt-12 font-mono text-xs text-zinc-600">
      <a href="/" class="hover:text-accent transition">← 返回项目集</a>
    </div>
  </div>
</Base>
